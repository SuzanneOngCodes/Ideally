APP_NAME=Ideally API
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./ideally.db
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=ideally-510010
GOOGLE_CLOUD_LOCATION=global
AGENT_TIMEOUT_SECONDS=120
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

TAVILY_API_KEY=

# Read original source pages via Crawl4AI Cloud /scrape.
CRAWL4AI_API_KEY=
CRAWL4AI_BASE_URL=https://api.crawl4ai.com
CRAWL_MAX_URLS=3
CRAWL_MAX_MARKDOWN_CHARS=12000
