# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# (Optional) SEMANTIC_SCHOLAR_API_KEY: For higher rate limits on Semantic Scholar Graph API.
# arXiv API works out-of-the-box with zero API key required.
SEMANTIC_SCHOLAR_API_KEY=""

# (Optional) TAVILY_API_KEY: For Tavily advanced web research search API.
TAVILY_API_KEY=""

# (Optional) GOOGLE_CUSTOM_SEARCH_KEY & GOOGLE_CUSTOM_SEARCH_CX: For Google Custom Search JSON API.
GOOGLE_CUSTOM_SEARCH_KEY=""
GOOGLE_CUSTOM_SEARCH_CX=""

# (Optional) GOOGLE_CLOUD_TRANSLATION_API_KEY: For Google Cloud Translation API (Basic/v2 or Advanced/v3)
# If not provided, the server seamlessly uses Google GenAI neural translation specialized for Japan and APAC languages.
GOOGLE_CLOUD_TRANSLATION_API_KEY=""
